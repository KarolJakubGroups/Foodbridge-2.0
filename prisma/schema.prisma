// FoodBridge 2.0 data model (PostgreSQL on Supabase). Enum-like columns are
// plain strings; allowed values are validated in lib/domain.ts.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String   @id @default(cuid())
  username         String   @unique
  email            String   @unique
  passwordHash     String
  role             String   // DONOR | FOODBANK | DISPATCHER
  status           String   @default("PENDING") // PENDING | APPROVED | REJECTED (donor verification)
  organizationName String
  address          String   @default("")
  contactName      String?
  phone            String?
  reviewedAt       DateTime?
  createdAt        DateTime @default(now())

  sessions        Session[]
  donations       Donation[]       @relation("DonorDonations")
  claims          Claim[]          @relation("FoodbankClaims")
  transportOrders TransportOrder[] @relation("DonorOrders")
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// A donation registered by a retailer, carrying the 7 mandatory fields.
model Donation {
  id               Int      @id @default(autoincrement())
  donorId          String
  donor            User     @relation("DonorDonations", fields: [donorId], references: [id])
  productName      String
  category         String   @default("OTHER") // see CATEGORIES in lib/domain.ts
  temperatureRange String   // preset (AMBIENT | COOL | CHILLED | SUPERCHILLED | FROZEN) or the donor's own text
  /// How the goods are packed, as the donor describes it (e.g. "Karton à 12 × 1 l"); optional.
  packagingUnit    String?
  /// What the pallets are made of: EURO | DISPOSABLE | PLASTIC | OTHER (see lib/domain.ts); null on offers from before it was asked.
  palletMaterial   String?
  bestBeforeDate   String   // YYYY-MM-DD (date only, no timezone)
  pickupAddress    String
  /// Pallets offered in total.
  numberOfPallets  Int
  /// Pallets reserved by institutions so far (sum of claims.pallets); never above numberOfPallets.
  claimedPallets   Int      @default(0)
  /// Weight of every pallet in kg, pallet 1 first; always numberOfPallets entries (pallets need not weigh the same).
  palletWeights    Float[]
  overlapStart     DateTime // pickup window start
  overlapEnd       DateTime // pickup window end
  /// AVAILABLE (pallets left) | CLAIMED (fully reserved) | WITHDRAWN. Logistics state lives on the claims.
  status           String   @default("AVAILABLE")
  createdAt        DateTime @default(now())

  claims Claim[]

  @@index([status, createdAt])
  @@index([donorId, createdAt])
}

/// An institution reserves some or all pallets of a donation. Each claim is picked up on its own.
model Claim {
  id               Int             @id @default(autoincrement())
  donationId       Int
  donation         Donation        @relation(fields: [donationId], references: [id])
  foodbankId       String
  foodbank         User            @relation("FoodbankClaims", fields: [foodbankId], references: [id])
  pallets          Int
  /// Which pallets of the donation (1-based numbers into donation.palletWeights); `pallets` entries.
  palletNumbers    Int[]
  /// Total weight of those pallets in kg, fixed when reserved.
  weightKg         Float
  /// RESERVED (waiting for a transport) | BUNDLED (in a transport order) | COMPLETED (delivered)
  status           String          @default("RESERVED")
  transportOrderId Int?
  transportOrder   TransportOrder? @relation(fields: [transportOrderId], references: [id])
  claimedAt        DateTime        @default(now())

  @@index([donationId])
  @@index([foodbankId, claimedAt])
  @@index([transportOrderId])
  @@index([status])
}

/// Consolidated Galliker pickup bundling several claims at one donor.
model TransportOrder {
  id                Int       @id @default(autoincrement())
  donorId           String
  donor             User      @relation("DonorOrders", fields: [donorId], references: [id])
  /// Pickup window: the span in which every bundled claim can be collected.
  pickupStart       DateTime
  pickupEnd         DateTime
  status            String    @default("PENDING") // PENDING | DISPATCHED | COMPLETED
  createdAt         DateTime  @default(now())
  /// Hand-over to Galliker (lib/galliker.ts): NOT_SENT | SENT | FAILED
  gallikerStatus    String    @default("NOT_SENT")
  gallikerReference String?
  gallikerSentAt    DateTime?
  gallikerError     String?
  /// Cached driving route for the dispatcher map (lib/geo.ts); [lng, lat] pairs.
  routeGeometry     Json?
  routeDistanceKm   Float?
  routeDurationMin  Float?
  routeComputedAt   DateTime?

  claims        Claim[]
  transmissions GallikerTransmission[]
}

/// Every message sent to Galliker, for audit and troubleshooting.
model GallikerTransmission {
  id         Int            @id @default(autoincrement())
  orderId    Int
  order      TransportOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// SANDBOX (simulated, default) | HTTP (real endpoint)
  mode       String
  endpoint   String?
  payload    Json
  /// SENT | FAILED
  status     String
  httpStatus Int?
  response   Json?
  error      String?
  createdAt  DateTime       @default(now())

  @@index([orderId, createdAt])
}

/// Geocoding cache for the dispatcher map (lib/geo.ts). Keyed by the normalised address text;
/// a row without coordinates records that the lookup found nothing, so it is not repeated on every load.
model GeocodedAddress {
  query       String   @id
  latitude    Float?
  longitude   Float?
  displayName String?
  lookedUpAt  DateTime @default(now())
}
