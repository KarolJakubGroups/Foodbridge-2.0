# Copy to .env and fill in. Supabase dashboard -> Connect -> "Session pooler" connection string.
# Example: postgresql://postgres.uhutkndryzyesxoeicnv:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Optional: separate database for `npm test`. By default tests use the schema
# "foodbridge_test" inside DATABASE_URL's database.
# TEST_DATABASE_URL=

# --- Galliker hand-over (lib/galliker.ts) --------------------------------------
# sandbox (default): simulated Galliker, no setup needed, answers with GLK-TEST-… references.
# http: POST to GALLIKER_API_URL/transport-orders with a bearer token and an idempotency key.
# GALLIKER_MODE=sandbox
# GALLIKER_API_URL=https://api.example-galliker.ch/v1
# GALLIKER_API_KEY=
# GALLIKER_TIMEOUT_MS=10000

# --- Dispatcher map (lib/geo.ts, components/DispatchMap.tsx) --------------------
# Defaults use the public OpenStreetMap services, fine for a demo. For production
# use your own or a commercial instance (they have usage limits).
# GEOCODER_URL=https://nominatim.openstreetmap.org
# GEOCODER_USER_AGENT=FoodBridge/2.0 (kontakt@example.ch)
# ROUTING_URL=https://router.project-osrm.org
# NEXT_PUBLIC_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
